  "components": [
    {
      "name": "Primary Pill Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main call to action on paper: claim, edit, find my association, log in.",
      "html": "<button class=\"ds-btn-primary\">Trouver mon association</button>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-btn-primary{height:44px;padding:0 20px;border:1px solid transparent;border-radius:9999px;background:var(--primary);color:var(--primary-foreground);font:700 1rem/1 inherit;font-family:inherit;cursor:pointer;transition:all .15s}.ds-btn-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline Pill Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action beside a primary pill (cancel, back).",
      "html": "<button class=\"ds-btn-outline\">Annuler</button>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-btn-outline{height:44px;padding:0 24px;border:1px solid var(--border);border-radius:9999px;background:var(--background);color:var(--foreground);font-family:inherit;font-size:1rem;cursor:pointer;transition:all .15s}.ds-btn-outline:hover{background:var(--muted)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Search Bar",
      "kind": "input",
      "refersTo": "search-bar",
      "description": "Three-cell search slab on the ultramarine shell: what, where, submit.",
      "html": "<div class=\"ds-shell\"><form class=\"ds-search\"><label class=\"ds-search-cell\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input placeholder=\"Nom, activité, centre d'intérêt…\"></label><label class=\"ds-search-cell ds-search-where\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg><input placeholder=\"Ville, CP ou département\"></label><button class=\"ds-search-submit\">Rechercher</button></form></div>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-shell{background:var(--shell);padding:32px}.ds-search{display:grid;grid-template-columns:1fr minmax(15rem,20rem) auto;height:76px;overflow:hidden;border-radius:1.35rem;background:var(--shell-field);box-shadow:0 10px 30px -12px rgb(0 0 0/.45);font-size:1.125rem}.ds-search:focus-within{box-shadow:0 10px 30px -12px rgb(0 0 0/.45),0 0 0 4px rgb(255 255 255/.2)}.ds-search-cell{display:flex;align-items:center;gap:12px;padding:0 20px;color:var(--muted-foreground)}.ds-search-where{border-left:1px solid var(--border)}.ds-search-cell input{all:unset;width:100%;color:var(--foreground);font-family:inherit}.ds-search-submit{border:0;padding:0 40px;background:var(--foreground);color:var(--background);font:700 1.125rem inherit;font-family:inherit;cursor:pointer;transition:background .15s}.ds-search-submit:hover{background:color-mix(in oklab,var(--foreground) 85%,transparent)}.ds-search-submit:focus-visible{outline:none;box-shadow:inset 0 0 0 4px var(--ring)}"
    },
    {
      "name": "Association Card",
      "kind": "card",
      "refersTo": "association-card",
      "description": "One result: theme band, mono RNA number and year, name, place, description, theme label, optional owner stamp.",
      "html": "<article class=\"ds-card\"><div class=\"ds-band\"></div><div class=\"ds-card-num\"><span>W691053064</span><span>2004</span></div><h2 class=\"ds-card-title\"><a href=\"#\">Le Sous Sol</a></h2><p class=\"ds-card-place\">Lyon 1er Arrondissement · 69001</p><p class=\"ds-card-desc\">L'enregistrement sonore et visuel des artistes ainsi que la production.</p><div class=\"ds-card-foot\"><p>Culture</p><span class=\"ds-stamp\">Infos de l'asso</span></div></article>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-card{position:relative;display:flex;flex-direction:column;width:320px;overflow:hidden;border-radius:1.05rem;background:var(--card);color:var(--foreground);box-shadow:0 0 0 1px var(--border);transition:box-shadow .15s}.ds-card:hover{box-shadow:0 6px 18px -8px rgb(20 24 33/.35),0 0 0 1px color-mix(in oklab,var(--primary) 60%,transparent)}.ds-card:focus-within{box-shadow:0 0 0 2px var(--ring)}.ds-band{height:10px;background:var(--theme-culture)}.ds-card-num{display:flex;justify-content:space-between;padding:12px 16px 0;font:500 .75rem 'JetBrains Mono',monospace;word-spacing:normal;color:var(--muted-foreground)}.ds-card-title{margin:0;padding:6px 16px 0;font-size:1.125rem;font-weight:700;line-height:1.375}.ds-card-title a{color:inherit;text-decoration:none;outline:none}.ds-card-title a::after{content:'';position:absolute;inset:0}.ds-card-place{margin:0;padding:2px 16px 0;font-size:.875rem}.ds-card-desc{margin:0;padding:8px 16px 0;font-size:.875rem;color:var(--muted-foreground);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-card-foot{display:flex;align-items:flex-end;justify-content:space-between;padding:12px 16px 16px}.ds-card-foot p{margin:0;font-size:.75rem;font-weight:600}.ds-stamp{display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;margin:-8px 0;padding:0 6px;border:2px solid var(--stamp);border-radius:9999px;transform:rotate(-6deg);color:var(--stamp);font-size:.625rem;font-weight:700;line-height:1.2;text-align:center;text-transform:uppercase}"
    },
    {
