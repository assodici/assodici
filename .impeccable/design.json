      "html": "<article class=\"ds-card ds-dissolved\"><div class=\"ds-band\"></div><div class=\"ds-perf\"></div><div class=\"ds-card-num\"><span>W000000000</span><span class=\"ds-dissoute\">Dissoute</span></div><h2 class=\"ds-card-title\">Votre association</h2><p class=\"ds-card-place\">Votre ville · 00000</p><div class=\"ds-card-foot\"><p>Solidarité</p></div></article>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-card{position:relative;display:flex;flex-direction:column;width:320px;overflow:hidden;border-radius:1.05rem;color:var(--foreground);box-shadow:0 0 0 1px var(--border)}.ds-dissolved{background:var(--muted)}.ds-band{height:10px;background:#e2b007}.ds-perf{border-top:2px dashed color-mix(in oklab,var(--muted-foreground) 50%,transparent)}.ds-card-num{display:flex;justify-content:space-between;align-items:baseline;padding:12px 16px 0;font:500 .75rem 'JetBrains Mono',monospace;color:var(--muted-foreground)}.ds-dissoute{font-family:'Schibsted Grotesk',sans-serif;font-weight:600;padding:2px 8px;border:1px dashed currentColor;border-radius:9999px}.ds-card-title{margin:0;padding:6px 16px 0;font-size:1.125rem;font-weight:700;text-decoration:line-through;text-decoration-thickness:2px}.ds-card-place{margin:0;padding:2px 16px 0;font-size:.875rem}.ds-card-foot{padding:12px 16px 16px}.ds-card-foot p{margin:0;font-size:.75rem;font-weight:600}"
    },
    {
      "name": "Owner Stamp",
      "kind": "custom",
      "refersTo": "owner-stamp",
      "description": "Rubber-stamp ring for owner-verified information; large size on the association hero card.",
      "html": "<span class=\"ds-stamp-lg\">Infos de l'asso</span>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-stamp-lg{display:inline-flex;align-items:center;justify-content:center;width:96px;height:96px;padding:0 8px;border:3px solid var(--stamp);border-radius:9999px;transform:rotate(-6deg);color:var(--stamp);font-size:.75rem;font-weight:700;letter-spacing:.025em;line-height:1.25;text-align:center;text-transform:uppercase}"
    },
    {
      "name": "Theme Chip",
      "kind": "chip",
      "refersTo": "theme-chip",
      "description": "Theme shortcut on the ultramarine shell with a theme-colour dot.",
      "html": "<div class=\"ds-shell\"><a class=\"ds-chip\" href=\"#\"><span class=\"ds-dot\"></span>Sports</a></div>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-shell{background:var(--shell);padding:24px}.ds-chip{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:9999px;background:rgb(255 255 255/.12);color:var(--shell-foreground);font-size:.875rem;font-weight:600;text-decoration:none;transition:background .15s}.ds-chip:hover{background:rgb(255 255 255/.22)}.ds-chip:focus-visible{outline:2px solid #fff}.ds-dot{width:10px;height:10px;border-radius:9999px;background:var(--theme-sport)}"
    },
    {
      "name": "Shell Header",
      "kind": "nav",
      "refersTo": "header",
      "description": "64px ultramarine bar: logo left, white semibold nav and account pill right.",
      "html": "<header class=\"ds-header\"><strong class=\"ds-logo\">ASSO D'ICI</strong><nav class=\"ds-nav\"><a href=\"#\">Rechercher</a><a href=\"#\">À propos</a><a href=\"#\" class=\"ds-account\">Connexion</a></nav></header>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-header{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:var(--shell);color:var(--shell-foreground)}.ds-logo{font-size:1.25rem;font-weight:800}.ds-nav{display:flex;align-items:center;gap:4px;font-size:.875rem;font-weight:600}.ds-nav a{color:inherit;text-decoration:none;padding:8px 12px;border-radius:.75rem;transition:background .15s}.ds-nav a:hover{background:rgb(255 255 255/.12)}.ds-nav a:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(255 255 255/.7)}.ds-nav .ds-account{margin-left:4px;height:36px;box-sizing:border-box;display:inline-flex;align-items:center;padding:0 16px;border:1px solid rgb(255 255 255/.6);border-radius:9999px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Form field on paper (profile edit, login).",
      "html": "<label class=\"ds-field\"><span>Adresse e-mail</span><input class=\"ds-input\" placeholder=\"vous@exemple.fr\"></label>",
      "css": ":host{--shell:#1f3fbf;--shell-foreground:#fff;--shell-muted:#d3dbff;--shell-field:#f7f8fc;--stamp:#1f3fbf;--background:#eef1f7;--foreground:#141821;--card:#fbfcfe;--primary:#1f3fbf;--primary-foreground:#fff;--muted:#e3e8f6;--muted-foreground:#4a5163;--border:#d5dae5;--input:#c5ccdb;--ring:#1f3fbf;--theme-culture:#d63c22;--theme-sport:#1a7f4b;font-family:'Schibsted Grotesk',sans-serif;word-spacing:.05em}.ds-field{display:flex;flex-direction:column;gap:6px;font-size:.875rem;font-weight:500;color:var(--foreground)}.ds-input{height:40px;padding:4px 10px;border:1px solid var(--input);border-radius:.75rem;background:transparent;color:var(--foreground);font:inherit;font-size:.875rem;outline:none;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-input[aria-invalid=true]{border-color:#b42318}"
    }
  ],
  "narrative": {
    "northStar": "Carte d'adhérent",
    "overview": "Every association is a membership card. The card is numbered by its RNA identifier, banded across the top by the colour of its theme family, and stamped in ultramarine ink when its owner vouches for the information. Cards live in an ultramarine wallet: the header, the home field, the search bar strip and the title band of reading pages are one continuous ultramarine shell, and the cards sit on it or just below it on cool paper.\n\nThe system is dense where people scan (a three-column card grid, small mono card numbers, one-line places) and generous where people decide (a 76px search bar, a 60px headline, a pill call to action). It is flat cardstock, not glossy UI: depth comes from the shell/paper contrast and one soft lift for objects lying on the ultramarine. There are no images; identity is carried by colour bands, the stamp and type alone. Light and dark share the same bands; dark swaps the shell to deep navy and the cards to graphite.\n\nIt refuses the white directory of blue links and grey rows. A result is never a table row; it is always a card.",
    "keyCharacteristics": [
      "Ultramarine shell carrying header, hero, search strip and page titles.",
      "Cool-white cardstock cards with a solid theme band on top.",
      "JetBrains Mono as the card-number voice, Schibsted Grotesk for everything else.",
      "Rubber-stamp ring for owner-verified information.",
      "Dissolved associations shown as struck, perforated cards, never hidden.",
      "Pill-shaped actions, generously rounded cards."
    ],
    "rules": [
      {
        "name": "The Ultramarine Wallet Rule",
        "body": "The top of every page is ultramarine shell: header plus the page's opening block (hero, search strip, association card, prose title). Content below sits on cool paper. Controls on the shell use white ink, a translucent white hover (12%) and a white focus outline.",
        "section": "colors"
      },
      {
        "name": "The Band Is the Theme Rule",
        "body": "Theme colour appears only as a solid band across the top of a card and as the small dot in a theme chip. Never as text, fill, border or button colour.",
        "section": "colors"
      },
      {
        "name": "The Card Number Rule",
        "body": "Mono is reserved for identifiers printed on the card: RNA number, SIRET, and the card's founding year. Places, postal codes and written dates (\"24 octobre 2026\") stay in Schibsted.",
        "section": "typography"
      },
      {
        "name": "The Lift on the Shell Rule",
        "body": "Only objects resting on the ultramarine shell carry a shadow at rest. Cards on paper are flat with a hairline ring and lift only on hover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** open every page with the ultramarine shell (#1f3fbf, #0d1a4d in dark) and let content continue on cool paper.",
      "**Do** render every association as a card with its theme band on top; use the 9-family map in `src/lib/themes.ts` and the 40% slate fallback.",
      "**Do** set RNA numbers and SIRET in JetBrains Mono 500, small and in slate ink.",
      "**Do** make actions full pills, 44px tall, bold.",
      "**Do** show the owner stamp only for claimed associations, and keep owner-provided text visibly attributed.",
      "**Do** keep dissolved associations visible as struck, perforated cards."
    ],
    "donts": [
      "**Don't** use theme colours for text, buttons or large fills; they are bands and dots.",
      "**Don't** add photos or illustrations; the product supports no images.",
      "**Don't** put shadows on cards resting on paper; lift is for the shell and hover.",
      "**Don't** use mono for prose dates, places or postal codes.",
      "**Don't** use uppercase outside the owner stamp.",
      "**Don't** present results as table rows or bare blue-link lists."
    ]
  }
}